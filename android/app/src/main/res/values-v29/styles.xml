<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark as the phone is set (the dashboard follows it); the settings screen keeps its dark background. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#101010</item>
        <item name="android:statusBarColor">#101010</item>
        <item name="android:navigationBarColor">#101010</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#ff3b30</item>
    </style>
</resources>
