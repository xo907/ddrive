# systemd *user* unit. Assumes the repository is at ~/DDrive;
# ./run.sh -> Tools -> "start at boot" prints a command that rewrites the path for you.
#   systemctl --user enable --now ddrive
#   sudo loginctl enable-linger $USER     # keep it running without a login session
[Unit]
Description=DDrive encrypted Discord-backed drive
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/DDrive
Environment=PYTHONPATH=%h/DDrive
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m ddrive mount
# Unmounting makes the daemon flush uploads and back up the index before exiting.
ExecStop=/usr/bin/python3 -m ddrive stop
KillSignal=SIGTERM
TimeoutStopSec=60
# Hard memory cap only (no MemoryHigh: a soft limit throttled DDrive into a silent hang). DDrive writes a
# drop-in (ddrive.service.d/50-ddrive-defaults.conf) with the cap for this computer: half its memory, at most 2 GB.
MemoryMax=2048M
MemorySwapMax=0
# Short of memory, the kernel's OOM killer (or earlyoom) takes DDrive, which restarts cleanly, before databases or sshd.
OOMScoreAdjust=300
Environment=MALLOC_ARENA_MAX=2
# Restarted when it stops answering (it pings systemd only while the mounted drive and the dashboard answer).
Type=notify
NotifyAccess=all
WatchdogSec=180
TimeoutStartSec=900
Restart=always
RestartSec=10
# 3: the drive's words were forgotten (forget-words): nothing to start until `ddrive words`.
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
